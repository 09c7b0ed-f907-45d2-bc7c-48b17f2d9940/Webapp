# Webapp environment template.
#
# Loaded automatically by Next.js (.env/.env.local) -- copy to .env in
# the repo root. Never commit the real one.
#
# Webapp owns the shared token vault: it writes real Keycloak tokens on
# login, and Action reads through Webapp's proxy to use them. CVaLab's
# separate login also writes into this same vault.

# --- NextAuth --------------------------------------------------------------

NEXTAUTH_URL=http://localhost:3000
# Real secret -- generate with `openssl rand -base64 32`, never hardcode.
NEXTAUTH_SECRET=
# NEXTAUTH_ACCESS_TOKEN_REFRESH_SAFETY_MS=

# --- Keycloak ------------------------------------------------------------

# Your Keycloak realm's issuer URL, e.g. https://<keycloak-host>/realms/<realm>
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=cva
# Real secret -- pull from wherever your team keeps it, never hardcode here.
KEYCLOAK_CLIENT_SECRET=

# --- Token vault (Redis) ---------------------------------------------------
# Same Redis instance Rasa's devcontainer provisions and exposes to the host.

USER_TOKEN_VAULT_REDIS_URL=redis://host.docker.internal:6379
USER_TOKEN_VAULT_REDIS_PREFIX=cva:user-token:
# USER_TOKEN_VAULT_BACKEND=redis
# USER_TOKEN_VAULT_TTL_MS=

# --- Job store (identity-mapping jobId -> sub/threadId/rasaUrl) ------------
# Local-file-equivalent is an in-memory Map -- fine for a single Webapp
# instance, but the instance that creates a job and the instance Action
# calls back into can differ once Webapp runs more than one replica, so
# redis is required at that point (see api/rasa/route.ts's createJob).

# JOB_STORE_REDIS_URL=redis://host.docker.internal:6379
# JOB_STORE_REDIS_PREFIX=cva:job:
# JOB_STORE_BACKEND=redis
# JOB_ID_TTL_SECONDS=1800

# --- SSE bus (live chat delivery) -------------------------------------------
# Same in-memory-vs-redis tradeoff as the job store above: in-memory only
# delivers to subscribers on the same Webapp instance. Required once Webapp
# runs more than one replica, otherwise messages published on one instance
# never reach a user whose SSE connection landed on another.

# SSE_BUS_REDIS_URL=redis://host.docker.internal:6379
# SSE_BUS_BACKEND=redis

# --- Rasa bots (chat UI) ---------------------------------------------------
# JSON array of {lang, url} -- required, no default.

RASA_URL_LIST=[{"lang":"en","url":"http://host.docker.internal:5005"}]

# Targets /api/rasa-proxy is allowed to forward to.
RASA_PROXY_TARGETS={"default":"http://host.docker.internal:5005"}
# RASA_PROXY_TIMEOUT_MS=

# Shared secret Action presents when it calls back into this proxy for
# GraphQL/analytics data -- must match Action's own ACTION_SERVER_TOKEN.
# Kept as a fallback; see ACTION_SERVICE_CLIENT_ID below for the real
# service identity.
ACTION_SERVER_TOKEN=

# Shared token Rasa's own custom routes expect (thread listing, hard
# delete, etc.) -- same value as Rasa's RASA_AUTH_TOKEN.
RASA_AUTH_TOKEN=

# Real per-service identity for Action (Phase 2 of the cross-service auth
# redesign) -- optional, off by default. When set, a Keycloak
# client-credentials bearer token presented by Action (verified via
# introspection, using this app's own KEYCLOAK_CLIENT_ID/_SECRET above) is
# accepted in place of ACTION_SERVER_TOKEN/LONG_TASK_CALLBACK_TOKEN. Must
# match Action's own ACTION_SERVICE_CLIENT_ID -- this identifies Action's
# dedicated Keycloak service-account client, not Webapp's own `cva` client.
# ACTION_SERVICE_CLIENT_ID=

# --- Long-running visualization task callbacks -----------------------------

# Shared secret Action's callback receiver checks -- same value as
# Action's/CVaLab's LONG_TASK_CALLBACK_TOKEN.
LONG_TASK_CALLBACK_TOKEN=
# Where Action should reach back into this Webapp instance for progress/
# final-result delivery.
CALLBACK_BASE_URL=http://host.docker.internal:3000

# --- Optional: feedback admin feature (off by default) --------------------
#
# Leave everything below unset unless you're specifically working on the
# feedback-admin feature -- without FEEDBACK_DATABASE_URL/FEEDBACK_DB_*,
# feedback storage falls back to a local file automatically (fine for dev).

# FEEDBACK_ADMIN_ENABLED=false
# MESSAGE_FEEDBACK_ENABLED=false
# FEEDBACK_DATABASE_URL=
# FEEDBACK_DB_HOST=
# FEEDBACK_DB_PORT=
# FEEDBACK_DB_NAME=
# FEEDBACK_DB_USER=
# FEEDBACK_DB_PASSWORD=
# FEEDBACK_DB_SSL=
# FEEDBACK_LOCAL_STORE_PATH=
# FEEDBACK_REPORTER_SALT=
# FEEDBACK_CAPTURE_CONTEXT_ENABLED=false
# FEEDBACK_COMMENT_MAX_LENGTH=

# --- Optional: interaction log feature (off by default) --------------------
#
# Separate from feedback above -- admin-controlled, full-turn chat capture
# for specific real users during initial testing. Leave everything below
# unset unless you're specifically working on this feature. Without
# INTERACTION_LOG_DATABASE_URL/INTERACTION_LOG_DB_*, storage falls back to
# a local file automatically (fine for dev).

# INTERACTION_LOG_ENABLED=false
# INTERACTION_LOG_ADMIN_EMAILS=
# INTERACTION_LOG_ADMIN_ROLES=
# INTERACTION_LOG_DATABASE_URL=
# INTERACTION_LOG_DB_HOST=
# INTERACTION_LOG_DB_PORT=
# INTERACTION_LOG_DB_NAME=
# INTERACTION_LOG_DB_USER=
# INTERACTION_LOG_DB_PASSWORD=
# INTERACTION_LOG_DB_SSL=
# INTERACTION_LOG_LOCAL_STORE_PATH=
# INTERACTION_LOG_LOCAL_ENTRIES_PATH=
# INTERACTION_LOG_MAX_RETENTION_DAYS=
# Required only if an admin ever sets storage_identity_mode to "pseudonymous".
# INTERACTION_LOG_PSEUDONYM_SALT=
